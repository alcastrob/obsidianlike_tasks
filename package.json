{
  "name": "obsidian-like-tasks",
  "displayName": "Obsidian-like Tasks",
  "description": "Manage markdown checkbox tasks a-la Obsidian Tasks, directly in VS Code",
  "version": "0.1.0",
  "publisher": "angelCastro",
  "icon": "media/obsidian-icon-violeta.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "tasks",
    "todo",
    "productivity"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "markdown": {
      "markdownItPlugins": true,
      "previewStyles": [
        "./media/tasks-preview.css"
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc -p ./",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && node esbuild.js --production && vsce package --allow-missing-repository"
  },
  "dependencies": {
    "chrono-node": "^2.9.1",
    "moment": "^2.29.4",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0"
  }
}
